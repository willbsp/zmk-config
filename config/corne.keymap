#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviours/num_word.dtsi>

&mt {
    tapping-term-ms = <125>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <160>;
};

&lt {
    tapping-term-ms = <125>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        caps: caps {
            compatible = "zmk,behavior-tap-dance";
            label = "CAPS";
            #binding-cells = <0>;
            bindings = <&caps_word>, <&kp CAPSLOCK>;

            tapping-term-ms = <300>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <100>;
            tapping-term-ms = <125>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            label = "Mac";
            bindings = <
&num_word 3  &kp Q        &kp W        &kp E         &kp R          &kp T        &kp Y        &kp U              &kp I         &kp O        &kp P                &tog 9
&kp LC(A)  &hml LALT A  &hml LGUI S  &hml LCTRL D  &hml LSHIFT F  &kp G        &kp H        &hmr LEFT_SHIFT J  &hmr RCTRL K  &hmr RGUI L  &hmr RALT SEMICOLON  &kp RG(SPACE)
&tog 1     &kp Z        &kp X        &kp C         &kp V          &kp B        &kp N        &kp M              &kp COMMA     &kp DOT      &kp FSLH             &caps
                                     &lt 6 ESCAPE  &lt 5 SPACE    &lt 7 TAB    &lt 4 ENTER  &lt 3 BACKSPACE    &lt 8 DELETE
            >;
        };

        base_overlay_linux {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &kp LG(D)
&tog 2  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &none
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Linux";
        };

        base_overlay_win {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &kp LGUI
&to 0   &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &none
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "Win";
        };

        number_layer {
            label = "Number";
            bindings = <
&none  &kp LEFT_BRACKET  &kp N7  &kp N8   &kp N9  &kp RIGHT_BRACKET    &none    &none          &none       &none     &none     &none
&none  &kp SINGLE_QUOTE  &kp N4  &kp N5   &kp N6  &kp EQUAL            &none    &kp RSHIFT     &kp RCTRL   &kp RGUI  &kp RALT  &none
&none  &kp GRAVE         &kp N1  &kp N2   &kp N3  &kp BACKSLASH        &none    &none          &none       &none     &none     &none
                                 &kp DOT  &kp N0  &kp MINUS            &kp RET  &kp BACKSPACE  &kp DELETE
            >;
        };

        symbol_layer {
            label = "Symbol";
            bindings = <
&none  &kp LS(LEFT_BRACKET)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(RIGHT_BRACKET)    &none    &none          &none       &none     &none     &none
&none  &kp LS(SINGLE_QUOTE)  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &kp LS(EQUAL)            &none    &kp RSHIFT     &kp RCTRL   &kp RGUI  &kp RALT  &none
&none  &kp LS(GRAVE)         &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &kp LS(BACKSLASH)        &none    &none          &none       &none     &none     &none
                                         &kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)            &kp RET  &kp BACKSPACE  &kp DELETE
            >;
        };

        navigation_layer {
            label = "Nav";
            bindings = <
&none  &none     &none     &none      &none      &none    &none       &none          &none      &none      &none     &none
&none  &kp LALT  &kp LGUI  &kp LCTRL  &kp LSHFT  &none    &kp LEFT    &kp DOWN       &kp UP     &kp RIGHT  &kp CAPS  &none
&none  &none     &none     &none      &none      &none    &kp INSERT  &kp PAGE_DOWN  &kp PG_UP  &kp HOME   &kp END   &none
                           &none      &none      &none    &kp ENTER   &kp BSPC       &kp A
            >;
        };

        media_layer {
            label = "Media";
            bindings = <
&none  &none     &none     &none      &none      &none    &none           &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none       &none  &none
&none  &kp LALT  &kp LGUI  &kp LCTRL  &kp LSHFT  &none    &kp C_PREVIOUS  &kp C_VOL_DN          &kp C_VOL_UP          &kp C_NEXT  &none  &none
&none  &none     &none     &none      &none      &none    &bt BT_CLR      &bt BT_PRV            &bt BT_NXT            &none       &none  &none
                           &none      &none      &none    &none           &kp C_PLAY            &kp C_MUTE
            >;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&none  &none     &none     &none      &none      &none    &none           &none           &none         &none            &none  &none
&none  &kp LALT  &kp LGUI  &kp LCTRL  &kp LSHFT  &none    &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
&none  &none     &none     &none      &none      &none    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
                           &none      &none      &none    &mkp LCLK       &mkp MCLK       &mkp RCLK
            >;
        };

        function_layer {
            label = "Func";
            bindings = <
&none  &none  &kp F7  &kp F8  &kp F9  &kp F10    &none    &none          &none       &none     &none     &none
&none  &none  &kp F4  &kp F5  &kp F6  &kp F11    &none    &kp RSHIFT     &kp RCTRL   &kp RGUI  &kp RALT  &none
&none  &none  &kp F1  &kp F2  &kp F3  &kp F12    &none    &none          &none       &none     &none     &none
                      &none   &none   &none      &kp RET  &kp BACKSPACE  &kp DELETE
            >;
        };

        game_base_layer {
            label = "Game";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R      &kp T      &kp Y      &kp U     &kp I       &kp O    &kp P     &tog 9
&kp LSHFT  &kp A  &kp S  &kp D     &kp F      &kp G      &kp H      &kp J     &kp K       &kp L    &kp SEMI  &sl 10
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V      &kp B      &kp N      &kp M     &kp COMMA   &kp DOT  &kp FSLH  &sl 11
                         &kp LALT  &kp SPACE  &kp TAB    &kp ENTER  &kp BSPC  &kp DELETE
            >;
        };

        game_number_layer {
            label = "Game (N)";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R      &kp T      &none  &kp N7  &kp N8  &kp N9  &none  &none
&kp LSHFT  &kp A  &kp S  &kp D     &kp F      &kp G      &none  &kp N4  &kp N5  &kp N6  &none  &none
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V      &kp B      &none  &kp N1  &kp N2  &kp N3  &none  &none
                         &kp LALT  &kp SPACE  &kp TAB    &none  &kp N0  &none
            >;
        };

        game_function_layer {
            label = "Game (F)";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E     &kp R      &kp T      &none  &kp F7  &kp F8  &kp F9  &kp F10  &none
&kp LSHFT  &kp A  &kp S  &kp D     &kp F      &kp G      &none  &kp F4  &kp F5  &kp F6  &kp F11  &none
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V      &kp B      &none  &kp F1  &kp F2  &kp F3  &kp F12  &none
                         &kp LALT  &kp SPACE  &kp TAB    &none  &none   &none
            >;
        };
    };
};
